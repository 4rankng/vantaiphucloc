# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vantaihanghoa

# Auth — SECRET_KEY MUST be changed from default in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment: development | production
# In production, the server will refuse to start if SECRET_KEY is still the default.
ENVIRONMENT=development

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Service — OpenRouter only (container OCR + Excel AI extraction).
# OpenAI-compatible endpoint. Get a key at https://openrouter.ai/settings/keys
# Container OCR requires OPENROUTER_ENABLE=true; the Excel AI extractor
# needs only the API key.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_ENABLE=true
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Docker Hub
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_PASSWORD=your-dockerhub-password
